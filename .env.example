VITE_APP_ENV="development"
VITE_ENABLE_DEBUG="true"
VITE_API_BASE_URL="http://localhost:8888/api"
VITE_APP_TITLE="⚡ Svelte Hub — Personal Dashboard"
VITE_APP_LOGO_URL="/logo.svg"
VITE_APP_FAVICON_URL="/favicon.svg"
