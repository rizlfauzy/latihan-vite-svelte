# Apps Hub — Environment Variables Reference
# Copy this file to .env or .env.local to customize your environment

VITE_APP_ENV="development"
VITE_ENABLE_DEBUG="true"
VITE_API_BASE_URL="http://localhost:8888/api"
VITE_APP_TITLE="⚡ Apps Hub — CV Sukses Gemilang"
VITE_APP_LOGO_URL="/logo.svg"
VITE_APP_FAVICON_URL="/favicon.svg"

# Supabase Configuration (Optional - falls back to local storage if empty)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Test / Admin Credentials (used in E2E tests)
ADMIN_PASSWORD="admin123"

